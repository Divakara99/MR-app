# PharmaSales Jobs — Supabase connection template
#
# 1. Run supabase/schema.sql once in the new project's SQL Editor.
# 2. Copy this file to .env.local for local/preview use.
# 3. Add the same values in the production host's environment-variable settings.
# 4. Rebuild and restart the app after changing these Vite variables.
#
# Find these values in Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use exactly one public browser key.
# New Supabase projects normally provide a publishable key:
VITE_SUPABASE_PUBLISHABLE_KEY=

# Older projects may provide the legacy anon public key instead:
VITE_SUPABASE_ANON_KEY=

# SECURITY: Never put the service_role key, a secret key, or the database
# password in this frontend project. Never commit .env.local.
